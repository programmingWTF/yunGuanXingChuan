# ============================================================
# 云观星传 — 环境变量配置模板
# ============================================================
# 使用方法：
#   1. 复制此文件并重命名为 .env
#   2. 填写下方各 API Key（获取方式见 SETUP_GUIDE.md）
#   3. 保存后即可运行项目
# ============================================================

# --- 阿里云百炼（通义千问）API ---
# 获取地址：https://bailian.console.aliyun.com/
# 注册登录后 → 模型广场 → API-KEY 管理 → 创建新的 API Key
QWEN_API_KEY=your_bailian_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max
QWEN_MODEL_FAST=qwen-plus
QWEN_MODEL_LONG=qwen-long

# --- Embedding（文本向量化）---
# 通常与 QWEN_API_KEY 共用即可，也可单独配置
QWEN_EMBEDDING_MODEL=text-embedding-v3
QWEN_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_EMBEDDING_API_KEY=your_bailian_api_key_here

# --- 阿里云百炼 WebSearch MCP（联网搜索）---
# 获取地址：https://bailian.console.aliyun.com/
# 与 QWEN_API_KEY 同一个控制台，可以使用同一个 Key
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# --- Tavily AI 搜索引擎（实时网页搜索，获取实际 URL）---
# 获取地址：https://app.tavily.com/
# 免费额度：每月 1000 次搜索
# 注册后 → Dashboard → 复制 API Key
TAVILY_API_KEY=your_tavily_api_key_here
# 可选：Tavily 请求代理（校内网络受限时使用，如 http://127.0.0.1:7890）
# TAVILY_PROXY=

# --- 他山世界 TopicLab 搜索（第三路搜索引擎，可选）---
# Token 由组长统一管理，需要时找组长申请；不填自动回退两路搜索
# TASHAN_TOKEN=your_tashan_token_here

# --- Pipeline 配置 ---
MAX_ITERATION_ROUNDS=3
PASS_THRESHOLD=75
# 是否启用 Agent 工具调用（KG 查询 / RAG 检索 / 新闻搜索等；置 false 则纯文本生成）
ENABLE_AGENT_TOOLS=true
API_PORT=8000

# --- 认知议会（Parliament）配置 ---
PARLIAMENT_MAX_ROUNDS=5
PARLIAMENT_DEADLOCK_THRESHOLD=0.15
PARLIAMENT_PASS_THRESHOLD=0.65
